{
	"name": "url-shortener",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"generate:api": "cd apps/api && go run ./cmd/openapi > openapi.json && cd ../.. && pnpm --filter @kurze-url/api-client generate && pnpm format",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "lefthook install",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@mheob/oxfmt-config": "^1.3.2",
		"@mheob/oxlint-config": "^3.0.1",
		"@types/node": "^22.20.1",
		"cve-lite-cli": "^1.31.0",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-regexp": "^3.2.0",
		"eslint-plugin-yml": "^3.8.1",
		"lefthook": "^2.1.12",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.25.0"
}
