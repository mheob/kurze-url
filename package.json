{
	"name": "kurze-url",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:reset": "supabase db reset",
		"dev": "node scripts/dev.ts",
		"dev:stop": "supabase stop; docker stop kurze-url-redis",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"generate:api": "cd apps/api && go run ./cmd/openapi > openapi.json && cd ../.. && pnpm --filter @kurze-url/api-client generate && pnpm format",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || echo 'skipping lefthook: not a git repository'",
		"test": "pnpm --recursive test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@mheob/oxfmt-config": "^1.3.3",
		"@mheob/oxlint-config": "^4.0.1",
		"@types/node": "^26.6.2",
		"cve-lite-cli": "^1.36.1",
		"eslint-plugin-better-tailwindcss": "^4.7.0",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-storybook": "^10.6.0",
		"eslint-plugin-yml": "^3.8.1",
		"lefthook": "^2.1.14",
		"oxfmt": "^0.70.0",
		"oxlint": "^1.85.0",
		"oxlint-tsgolint": "^7.0.2002",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.6.0"
}
