{
	"name": "kurze-url",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "vp check",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:reset": "supabase db reset",
		"dev": "node scripts/dev.ts",
		"dev:stop": "supabase stop; docker stop kurze-url-redis",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"generate:api": "cd apps/api && go run ./cmd/openapi > openapi.json && cd ../.. && pnpm --filter @kurze-url/api-client generate && pnpm format",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || echo 'skipping lefthook: not a git repository'",
		"test": "pnpm --recursive test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@mheob/oxfmt-config": "^1.3.3",
		"@mheob/oxlint-config": "^4.1.1",
		"@types/node": "^26.6.3",
		"cve-lite-cli": "^1.37.0",
		"eslint-plugin-better-tailwindcss": "^4.9.1",
		"eslint-plugin-jsonc": "^3.4.2",
		"eslint-plugin-regexp": "^3.3.1",
		"eslint-plugin-storybook": "^10.6.1",
		"eslint-plugin-yml": "^3.8.1",
		"lefthook": "^2.1.15",
		"typescript": "^7.0.2",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.13.0"
}
