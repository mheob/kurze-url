{
	"name": "kurze-url",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "vp check",
		"check:vite-plus": "node scripts/check-vite-plus-versions.ts",
		"cve": "cve-lite . --fail-on high --verbose --cache-dir .cache/cve-lite",
		"db:reset": "supabase db reset",
		"dev": "node scripts/dev.ts",
		"dev:stop": "supabase stop; docker stop kurze-url-redis",
		"format": "vp fmt",
		"format:check": "vp fmt --check",
		"generate:api": "cd apps/api && go run ./cmd/openapi > openapi.json && cd ../.. && pnpm --filter @kurze-url/api-client generate && pnpm format",
		"lint": "vp lint",
		"lint:fix": "vp lint --fix",
		"prepare": "git rev-parse --git-dir > /dev/null 2>&1 && lefthook install || echo 'skipping lefthook: not a git repository'",
		"test": "pnpm --recursive test",
		"typecheck": "tsc --noEmit"
	},
	"devDependencies": {
		"@mheob/oxfmt-config": "catalog:",
		"@mheob/oxlint-config": "catalog:",
		"@types/node": "catalog:",
		"cve-lite-cli": "catalog:",
		"eslint-plugin-better-tailwindcss": "catalog:",
		"eslint-plugin-jsonc": "catalog:",
		"eslint-plugin-regexp": "catalog:",
		"eslint-plugin-storybook": "catalog:",
		"eslint-plugin-yml": "catalog:",
		"lefthook": "catalog:",
		"typescript": "catalog:",
		"vite-plus": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.13.0"
}
