{
	"compilerOptions": {
		"target": "es2025",
		"lib": ["ES2025", "DOM"],
		"module": "preserve",
		"moduleResolution": "bundler",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"noEmit": true
	},
	"include": ["*.config.ts", "packages/*/src/**/*.ts"]
}
