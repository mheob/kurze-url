# Never commit real values. Production values live in Vercel's project
# environment variables; local values belong in apps/api/.env (gitignored).

PORT=8080

# The single hostname that serves /v1. Every other Host header is treated as a
# short-link domain and routed to the redirect surface. On Vercel this falls
# back to VERCEL_BRANCH_URL and then VERCEL_URL when unset, which is what lets
# preview deployments serve /v1 at all — their hostnames are minted per
# deployment, so no fixed value can match one. The branch alias comes first
# because that is the hostname @vercel/related-projects hands the web app.
# Set it explicitly in production, leave it unset for previews.
API_HOSTNAME=localhost

# The instance's own short hostname: the domain every team's links use until
# that team brings its own, upserted into `domain` (team_id IS NULL) at boot.
# It MUST differ from API_HOSTNAME — the router compares the request's Host
# against API_HOSTNAME and sends everything else to the redirect surface, so a
# shared hostname equal to the API's makes /{slug} unreachable. The port is
# ignored when routing but is kept in the stored hostname, which is what makes
# the composed short_url clickable locally. Changing this later upserts a new
# domain row rather than renaming the old one, so links created under the
# previous hostname keep pointing at it.
SHARED_DOMAIN_HOSTNAME=127.0.0.1:8080

# Supabase Postgres. Locally this is what `supabase start` prints; in
# production use the Supavisor transaction pooler (port 6543), not a direct
# connection — serverless instances open far more connections than the free
# tier's direct limit allows.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54322/postgres

# Upstash Redis. Use the rediss:// URL in production.
REDIS_URL=redis://127.0.0.1:6379

# Supabase auth. ES256 via JWKS — never the legacy HS256 shared secret. These
# three are required together: the API starts with any subset unset, but then
# every /v1 operation that declares bearerAuth rejects all requests, and
# setting only SUPABASE_JWKS_URL without the other two fails the API at
# startup instead of failing open.
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=https://<project>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated

# Keys the daily-rotating visitor hash. Rotating this resets unique-visitor
# counts for the current day; it is never logged and never leaves the process.
VISITOR_SALT=

# Rate limits. The values were settled on 2026-09-08; each one carries its own
# reasoning below, and this caveat is up here because it applies to all of them.
#
# Every limit in this file caps ONE subject inside ONE window: an IP, a user, a
# team, a domain. That shape stops a single runaway client, and stopping a
# single runaway client is the whole of what it can do. It cannot bound a
# shared monthly quota, because the quota is spent by subjects the limiter
# never compares — ten clients each staying inside their own window still add
# up to whatever ten of them add up to. Where a shared quota is the thing
# actually at risk, either the bound has to be global as well (see
# RATE_LIMIT_INVITE_GLOBAL_PER_MONTH) or the protection is monitoring rather
# than a limiter. Do not raise or lower one of these expecting it to defend a
# free-tier ceiling.

# Redirects per minute, per client IP. The address is HMAC'd before it becomes
# a key and is never stored.
#
# The lower bound is set by NAT: a mobile carrier's shared egress, a Verein's
# office, and the link scanners mail providers run when a newsletter goes out
# all arrive from one address, so much below this starts refusing exactly the
# traffic the instance exists to serve. There is no useful upper bound, which
# is the next paragraph.
#
# What it does NOT do: protect Upstash's 500K commands a month. One IP staying
# inside this limit spends the entire month's budget in somewhere between 21
# hours and 2.9 days, and a refused request still costs two commands. The
# spread is there because Upstash does not document whether a Lua EVAL counts
# as one command or as the commands inside it, and the redirect path runs two
# scripts (ratelimit.lua: GET GET INCR EXPIRE; redirect_lookup.lua: GET SADD
# EXPIRE). Watching that budget is the alerting item still open in CLAUDE.md.
#
# 0 disables the axis, as it does for every limit here except
# RATE_LIMIT_INVITE_GLOBAL_PER_MONTH. Worth stating on this one in particular:
# the limiter's script refuses at 0 rather than allowing, so without the
# guard in allowRedirect a zero meant to read "no limit" would have answered
# 429 to every visitor on the instance.
RATE_LIMIT_REDIRECT_PER_MIN=60

# Password guesses per minute, per protected link per client IP.
#
# Five is what a person needs to retype a password they already know. Argon2id
# makes each guess expensive; only this limit makes guessing slow.
#
# What it does NOT do: bound an attacker who rotates addresses.
# RATE_LIMIT_PASSWORD_FAILURES_PER_HOUR below is the second, IP-independent
# axis: it caps failed attempts per link regardless of source address, so a
# distributed attempt runs into that cap instead of this one.
RATE_LIMIT_PASSWORD_PER_MIN=5

# Password changes per hour, per user. PUT /v1/links/{id}/password computes an
# Argon2id hash: 19 MiB and two passes, every call. An authenticated member
# looping the endpoint is a CPU and memory amplifier, and no other limit
# guards that route. Twenty an hour is far above any real use — a Verein sets
# a link's password once and rarely changes it.
#
# The check runs before the password policy, so a request the policy
# rejects — which costs no Argon2id at all — still spends this same budget.
#
# 0 disables this axis: like every other per-subject limit in this file
# except RATE_LIMIT_INVITE_GLOBAL_PER_MONTH, it means "not enforced," not
# "refuse everything."
RATE_LIMIT_PASSWORD_SET_PER_HOUR=20

# Failed password attempts per hour, per link, on POST /{slug}/verify. Sits
# beside RATE_LIMIT_PASSWORD_PER_MIN, which is per link AND per IP and so
# bounds nobody who rotates addresses.
#
# This axis protects the function, not the password. With the policy in
# apps/api/internal/auth/policy.go in place, eight characters that are not
# derived from context outlast any rate anyone can drive over HTTP; what
# stays unbounded is 19 MiB and two Argon2id passes per guess, triggered by
# somebody with no account. A hundred an hour bounds that at a known number —
# and the honest cost of that number is real, not prohibitive: one request
# every 36 seconds is trivially scriptable and sustainable from a SINGLE
# address, since the per-IP cap above (RATE_LIMIT_PASSWORD_PER_MIN=5) permits
# 300 an hour, three times this. Once the counter reaches the limit, the
# interstitial refuses everyone on that link, including the Verein's own
# members, for the rest of the sliding window. That tradeoff is accepted
# deliberately rather than avoided: any per-link failure cap has this
# property, and leaving Argon2id verification unbounded against a caller
# with no account is the worse outcome.
#
# Only FAILURES count. A visitor who knows the password consumes nothing, so
# a link whose password a whole Verein has been given never approaches this
# no matter how many people follow it.
#
# 0 disables this axis too, the same as RATE_LIMIT_PASSWORD_SET_PER_HOUR
# above — not the invitation limit's "refuse everything."
RATE_LIMIT_PASSWORD_FAILURES_PER_HOUR=100

# Links created per minute, per user. By hand nobody exceeds five; twenty
# leaves room for the CLI. Its job is to stop a runaway script.
#
# What it does NOT do: bound how much of Supabase's 500 MB one member can
# fill. Sustained creation at this rate is roughly 8.6 MB a day. What keeps
# that from happening is that the instance is invitation-only and every
# creation lands in the audit log.
RATE_LIMIT_LINK_CREATE_PER_MIN=20

# Comma-separated Supabase user IDs allowed to create teams. Empty (the
# default) means nobody can: this is one shared instance, and self-service team
# creation is deliberately not enabled. A Verein asks the maintainer, who
# creates the team and invites its first owner.
MAINTAINER_USER_IDS=

# Supabase Admin API, used for exactly one call: sending a team invitation
# email. SUPABASE_AUTH_URL defaults to SUPABASE_JWT_ISSUER and rarely needs
# setting. The service-role key bypasses every database policy — never log it,
# never expose it to the frontend or the CLI.
SUPABASE_AUTH_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Invitations per hour, per team. A burst guard: it keeps one team from
# hammering the endpoint, and nothing more.
RATE_LIMIT_INVITE_PER_HOUR=20

# Invitations across the whole instance, over a rolling 30 days. This is the
# limit that actually bounds the mail budget, and it exists because the
# per-team one above cannot. Resend's free tier is 3,000 mails a month for all
# Supabase auth email together, and ten teams each staying inside 20 an hour
# would be some fifty times that.
#
# 200 is about four times realistic use — a Verein invites its members once and
# then rarely — which leaves the rest of the quota to magic-link sign-ins, the
# load-bearing consumer. Sign-in here has no password fallback, so an exhausted
# quota locks everybody out with no way back in from inside the app. Reaching
# this limit is logged at error level, so it reaches Sentry rather than only
# Vercel's one-day log retention.
#
# Unlike the other limits, 0 here does not mean "off" — it refuses every
# invitation. The members path fails closed throughout on purpose: it also
# answers 500 rather than allowing the request when Redis itself is
# unreachable.
#
# One hole this does not close: apps/web calls signInWithOtp directly, so
# sign-in mail is spent outside the API and outside this counter, bounded only
# by Supabase's own limits.
RATE_LIMIT_INVITE_GLOBAL_PER_MONTH=200

# Domain claims per hour, per user. A Verein claims one or two domains ever,
# and a claim reserves nothing — uniqueness lives on the verified row, not on
# the attempt — so this only has to stop a loop.
RATE_LIMIT_DOMAIN_CLAIM_PER_HOUR=5

# Verification attempts per hour, on two axes carrying two different
# thresholds. Each attempt costs a DNS lookup and an outbound TLS fetch to a
# third party.
#
# The per-domain axis is the tight one: DNS propagation takes time, so more
# than about ten attempts an hour against the same domain cannot succeed
# anyway. The per-user axis has to be the looser one, because one person
# legitimately onboards several domains at once. The two shared a single
# threshold until 2026-09-08, which meant a maintainer verifying three domains
# ran out of user allowance while every one of those domains was still well
# inside its own.
RATE_LIMIT_DOMAIN_VERIFY_PER_DOMAIN_PER_HOUR=10
RATE_LIMIT_DOMAIN_VERIFY_PER_USER_PER_HOUR=40

# Onboarding a custom domain has an order, and it is not the obvious one.
# Verification checks the DNS TXT token AND fetches https://<hostname>/health
# expecting "status":"ok". The fetch can only succeed once Vercel serves that
# hostname with a certificate, and Vercel only does that for a domain added
# to the kurze-url-api project by hand — the backend holds no Vercel token on
# purpose. So:
#
#   1. the team claims the hostname in the app
#   2. THE MAINTAINER adds it to the kurze-url-api Vercel project
#   3. the team publishes the TXT record and the CNAME below
#   4. the team clicks Verify
#
# Skip step 2 and verification reports a passing TXT check with a failing
# reachability check, which reads as "your DNS is wrong" when their DNS is
# fine.

# What a Verein is told to point their CNAME at.
#
# The value below is the generic record, and it is deliberately NOT what
# production serves. Vercel now hands out a per-project target and calls this
# generic one a legacy record that "will continue to work" — so the generic
# record is the safe fallback, and production overrides it with the
# per-project target set as an environment variable on the kurze-url-api
# Vercel project.
#
# Read the per-project target by adding any throwaway subdomain to that
# project: Vercel's DNS instructions name it, and you can remove the
# subdomain again straight away. It looks like <hex>.vercel-dns-NNN.com. It
# is not a secret — every Verein publishes it in their own public DNS zone —
# but it identifies one specific Vercel project, so it stays out of a public
# repository and lives in the project's own configuration instead.
#
# Two reasons that indirection is worth the extra step. The per-project
# target is bound to the kurze-url-api PROJECT: recreating or moving that
# project changes the target, and the value by then sits in DNS zones owned
# by the Vereine, each of whom would have to edit it by hand. And if the
# variable is ever forgotten, the fallback below still works, so the failure
# mode is "slightly out of date", not "every custom domain is broken".
DOMAIN_DNS_TARGET=cname.vercel-dns.com

# Guards GET /health/deep, the endpoint the uptime monitor polls. Unset
# disables the endpoint entirely (it answers 404), which is deliberate: a
# forgotten value must not expose dependency status. 32 random characters.
HEALTH_CHECK_TOKEN=

# Sentry error reporting. Empty disables it entirely — errors are still
# logged, they just do not outlive Vercel's one-day log retention. The free
# Developer tier allows 5,000 events per month, which is why only
# slog.LevelError records are reported and tracing stays off.
SENTRY_DSN=
