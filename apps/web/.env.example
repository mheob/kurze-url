# Never commit real values. Preview and Production values live in the Vercel
# project's environment variables; local values belong in apps/web/.env or
# apps/web/.env.local — both are gitignored, and the dev server reads either
# one into process.env.

# Supabase, read on the server only. Required for the app to render at all:
# the root route builds a request-bound Supabase client on every render, so
# without these the very first response is
# "SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY are required" — the public pages
# fail exactly like the authenticated ones.
#
# On Vercel these two exist on the Preview and Production environments only,
# so `vercel env pull` returns neither until they are added to Development as
# well. Both come from the Supabase project's API settings. The publishable
# key is the one Supabase designates as safe to expose to clients, never the
# service-role key — this app is not given that key and does not need it.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# The Go API's base URL. Leave it unset for local development: the lookup
# falls back to @vercel/related-projects, which pairs a preview of this app
# with the matching preview of the API and resolves to http://localhost:8080
# off-platform, so `apps/api` running locally is picked up with no
# configuration. Set it only to aim this app at some other API. In Production
# it is set on Vercel and wins outright, because it has to name the same host
# as the API's own API_HOSTNAME.
API_HOST=

# Sentry, browser and server. Empty disables reporting entirely. Public by
# design — this value ships inside the client bundle.
VITE_SENTRY_DSN=

# Build-time only, for the source-map upload. Absent skips the upload
# without failing the build, which is what keeps local and fork builds
# working.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
